---
/**
 * Retrato tipográfico. Usar a foto de uma pessoa real para um advogado
 * fictício seria atribuir identidade falsa a alguém — por isso, sem foto,
 * o retrato é composto pelas iniciais. Com `photo` preenchido, a foto entra.
 */
import type { Lawyer } from '@/data/team';
interface Props {
  lawyer: Lawyer;
  size?: 'card' | 'hero';
  reveal?: boolean;
}
const { lawyer, size = 'card', reveal = false } = Astro.props;
const [first, second] = lawyer.initials.split('');
---

<div class:list={['portrait', `portrait--${lawyer.tone}`, `portrait--${size}`]} data-reveal={reveal ? 'clip' : undefined}>
  {
    lawyer.photo ? (
      <img src={lawyer.photo} alt={`Retrato de ${lawyer.name}`} width="800" height="1000" loading="lazy" decoding="async" />
    ) : (
      <svg viewBox="0 0 400 500" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
        <line x1="0" y1="118" x2="400" y2="118" class="portrait__rule" />
        <line x1="62" y1="0" x2="62" y2="500" class="portrait__rule" />
        <text x="46" y="400" class="portrait__initial">{first}</text>
        <text x="384" y="468" text-anchor="end" class="portrait__initial portrait__initial--second">{second}</text>
        <text x="80" y="92" class="portrait__since">desde {lawyer.since}</text>
      </svg>
    )
  }
</div>

<style>
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    --p-bg: var(--paper-100);
    --p-fg: var(--ink-900);
    --p-rule: var(--rule-300);
    background: var(--p-bg);
  }
  .portrait--stone {
    --p-bg: #d9d3c6;
    --p-fg: var(--ink-900);
    --p-rule: #bdb5a6;
  }
  .portrait--lacre {
    --p-bg: var(--lacre-700);
    --p-fg: var(--paper-50);
    --p-rule: #a8463a;
  }
  .portrait svg,
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait__rule {
    stroke: var(--p-rule);
    stroke-width: 1;
  }
  .portrait__initial {
    fill: var(--p-fg);
    font-family: var(--font-display);
    font-size: 330px;
    letter-spacing: -0.04em;
  }
  .portrait__initial--second {
    font-style: italic;
    font-size: 250px;
  }
  .portrait__since {
    fill: var(--p-fg);
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }
</style>
