---
/**
 * O Mapa do Caso como objeto: um documento que se preenche conforme as
 * etapas do método avançam (desktop). Sem JS, ou com movimento reduzido,
 * aparece completo. O conteúdo é um exemplo de formato, não um caso real.
 */
import { CASE_MAP_SAMPLE } from '@/data/method';
const s = CASE_MAP_SAMPLE.sections;
const stepOf = [2, 3, 3, 4, 4];
---

<figure class="casemap" data-casemap aria-labelledby="casemap-caption">
  <div class="casemap__sheet">
    <header class="casemap__head" data-doc-step="1">
      <div class="casemap__head-row">
        <span class="label label--accent">{CASE_MAP_SAMPLE.title}</span>
        <span class="casemap__tag">Exemplo ilustrativo</span>
      </div>
      <p class="casemap__subject">{CASE_MAP_SAMPLE.subject}</p>
      <p class="casemap__meta small muted">Preparado após a reunião de análise · linguagem clara, sem jargão</p>
    </header>

    <dl class="casemap__body">
      {
        s.map((sec, i) => (
          <div class="casemap__sec" data-doc-step={stepOf[i]}>
            <dt class="label">{sec.label}</dt>
            <dd>
              <span class="casemap__text">
                {sec.text.split('\n').map((line) => (
                  <span class="casemap__line">{line}</span>
                ))}
              </span>
              <span class="casemap__ghost" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
            </dd>
          </div>
        ))
      }
    </dl>

    <footer class="casemap__foot" data-doc-step="5">
      <div>
        <span class="casemap__sign">Helena Quintela</span>
        <span class="small muted">Advogada responsável pelo caso</span>
      </div>
      <svg class="casemap__seal" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <circle cx="32" cy="32" r="29" fill="currentColor"></circle>
        <circle cx="32" cy="32" r="22" fill="none" stroke="var(--paper-50)" stroke-width="0.8" stroke-dasharray="1.5 2.5"></circle>
        <text x="32" y="37.5" text-anchor="middle" fill="var(--paper-50)" font-family="Newsreader Display, Georgia, serif" font-size="17" font-style="italic">QB</text>
      </svg>
    </footer>
  </div>
  <figcaption id="casemap-caption" class="casemap__caption small muted">
    O Mapa do Caso: o retrato da situação, entregue por escrito antes de qualquer decisão.
  </figcaption>
</figure>

<style>
  .casemap {
    position: relative;
    display: grid;
    gap: var(--s-4);
  }
  .casemap__sheet {
    position: relative;
    background: #fbf9f4;
    border: 1px solid var(--color-rule);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    display: grid;
    gap: var(--s-5);
    color: var(--ink-900);
  }
  /* uma segunda folha por baixo: profundidade sem sombra */
  .casemap__sheet::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(8px, 8px);
    border: 1px solid var(--color-rule);
    background: var(--paper-100);
    z-index: -1;
  }
  .casemap__head {
    display: grid;
    gap: var(--s-2);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--ink-900);
  }
  .casemap__head-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
  }
  .casemap__tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-2);
  }
  .casemap__subject {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.012em;
  }
  .casemap__body {
    display: grid;
    gap: var(--s-4);
  }
  .casemap__sec {
    display: grid;
    gap: var(--s-1);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--color-rule);
  }
  .casemap__sec dd {
    position: relative;
    font-size: var(--step--1);
    line-height: 1.55;
  }
  .casemap__line {
    display: block;
  }
  .casemap__ghost {
    position: absolute;
    inset: 0.35em 0 auto;
    display: grid;
    gap: 0.6em;
    opacity: 0;
    pointer-events: none;
  }
  .casemap__ghost i {
    display: block;
    height: 0.5em;
    background: var(--paper-200);
  }
  .casemap__ghost i:nth-child(2) {
    width: 86%;
  }
  .casemap__ghost i:nth-child(3) {
    width: 58%;
  }
  .casemap__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .casemap__foot > div {
    display: grid;
  }
  .casemap__sign {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .casemap__seal {
    width: 3.75rem;
    height: 3.75rem;
    color: var(--lacre-700);
    flex: none;
  }
  .casemap__caption {
    padding-left: 2px;
    margin-top: var(--s-2);
  }

  /* Preenchimento progressivo — só quando o script vincula o documento às etapas */
  .casemap[data-linked] [data-doc-step] .casemap__text,
  .casemap[data-linked] .casemap__head[data-doc-step] > *,
  .casemap[data-linked] .casemap__foot[data-doc-step] > * {
    transition:
      opacity 600ms var(--ease-out),
      transform 700ms var(--ease-out);
  }
  .casemap[data-linked] .casemap__ghost {
    transition: opacity 400ms var(--ease-out);
  }
  .casemap[data-linked] [data-doc-step]:not(.is-shown) .casemap__text {
    opacity: 0;
    transform: translateY(6px);
  }
  .casemap[data-linked] [data-doc-step]:not(.is-shown) .casemap__ghost {
    opacity: 1;
  }
  .casemap[data-linked] .casemap__head:not(.is-shown) > *:not(.casemap__head-row) {
    opacity: 0.12;
  }
  .casemap[data-linked] .casemap__foot:not(.is-shown) > * {
    opacity: 0;
    transform: translateY(6px);
  }
  .casemap[data-linked] .casemap__foot:not(.is-shown) .casemap__seal {
    transform: scale(0.9) rotate(-12deg);
  }
  .casemap[data-linked] .casemap__foot .casemap__seal {
    transition:
      opacity 500ms var(--ease-out),
      transform 700ms var(--ease-out);
  }
</style>
