---
const manifesto =
  'A maioria das pessoas chega até nós no meio de algo que já começou: uma separação, uma herança, um desacordo entre sócios. Antes de falar em processo, fazemos a pergunta que costuma ficar para depois — o que, exatamente, está em jogo?';
const words = manifesto.split(' ');

const principles = [
  {
    title: 'O processo é um caminho, não o ponto de partida.',
    text: 'Muitas questões se resolvem melhor por acordo, mediação ou em cartório. Quando o processo é necessário, entramos nele com o caso organizado.',
  },
  {
    title: 'Família e patrimônio, na mesma conversa.',
    text: 'Uma separação mexe na empresa; uma herança mexe nos imóveis. Por isso as quatro áreas do escritório trabalham como uma só.',
  },
  {
    title: 'Clareza antes de estratégia.',
    text: 'Antes de recomendar qualquer caminho, explicamos a situação em linguagem simples — e por escrito.',
  },
];
---

<section id="escritorio" class="office section" data-section="escritorio" aria-labelledby="office-title">
  <div class="container">
    <span class="rule rule--strong office__rule" data-reveal="rule" aria-hidden="true"></span>
    <div class="office__grid">
      <div class="office__meta">
        <h2 id="office-title" class="label label--accent">01 · O escritório</h2>
        <p class="office__since small muted">Fundado em 2014 por Helena Quintela e Otávio Brandt, em Belo Horizonte.</p>
      </div>

      <p class="office__manifesto" data-scrub-words>
        {words.map((w) => <><span class="w">{w}</span> </>)}
      </p>

      <ol class="office__principles" role="list">
        {
          principles.map((p, i) => (
            <li data-reveal="fade">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h4">{p.title}</h3>
              <p class="muted">{p.text}</p>
            </li>
          ))
        }
      </ol>

      <a class="arrow-link office__link" href="/escritorio/"><span>A história do escritório</span><span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .office__rule {
    margin-bottom: var(--s-7);
  }
  .office__grid {
    display: grid;
    gap: var(--s-7);
  }
  .office__meta {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .office__since {
    max-width: 24ch;
  }
  .office__manifesto {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.12;
    letter-spacing: -0.018em;
    max-width: 24ch;
    text-wrap: pretty;
  }
  .office__principles {
    display: grid;
    gap: var(--s-6);
  }
  .office__principles li {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--color-rule);
    max-width: 34ch;
  }
  .office__principles p {
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .office__link {
    justify-self: start;
  }
  @media (min-width: 48rem) {
    .office__principles {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--gutter);
    }
  }
  @media (min-width: 64rem) {
    .office__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      row-gap: var(--s-8);
    }
    .office__meta {
      grid-column: 1 / span 3;
    }
    .office__manifesto {
      grid-column: 4 / span 9;
    }
    .office__principles,
    .office__link {
      grid-column: 4 / span 9;
    }
  }
</style>
