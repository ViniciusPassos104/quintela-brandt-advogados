---
import ArticleRow from '@/components/ArticleRow.astro';
import { getArticles } from '@/lib/articles';
const latest = (await getArticles()).slice(0, 3);
---

<section id="artigos" class="section articles-teaser" data-section="artigos" aria-labelledby="articles-title">
  <div class="container">
    <div class="section-head">
      <p class="label label--accent">05 · Artigos</p>
      <div class="section-head__title stack" style="--stack: var(--s-5)">
        <h2 id="articles-title" class="h2" data-reveal="lines">Para entender antes de decidir</h2>
        <p class="lead">Textos curtos, escritos pela equipe, sobre as dúvidas que mais ouvimos nas reuniões.</p>
      </div>
    </div>
    <div class="articles-teaser__list" data-reveal="fade">
      {latest.map((a) => <ArticleRow article={a} />)}
    </div>
    <a class="arrow-link articles-teaser__all" href="/artigos/"><span>Todos os artigos</span><span class="arrow" aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .articles-teaser__list {
    border-top: 1px solid var(--color-text);
  }
  .articles-teaser__all {
    margin-top: var(--s-6);
  }
</style>
