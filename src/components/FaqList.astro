---
/**
 * Perguntas frequentes com <details>/<summary> nativos: funcionam sem JS,
 * são acessíveis por teclado e aparecem na busca da página (Ctrl+F).
 * A abertura é animada em CSS onde o navegador suporta ::details-content.
 */
import type { Faq } from '@/data/areas';
interface Props {
  items: (Faq & { id?: string })[];
  name?: string;
  headingLevel?: 'h3' | 'h4';
}
const { items, name, headingLevel: H = 'h3' } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item" name={name} id={item.id}>
        <summary class="faq__q">
          <H class="faq__q-text">{item.q}</H>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--color-text);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-rule);
  }
  .faq__q {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-5);
    padding-block: var(--s-5);
    cursor: pointer;
    list-style: none;
    min-height: 3rem;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q-text {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: -0.005em;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .faq__q:hover .faq__q-text {
    color: var(--color-accent);
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.3rem;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-ui) var(--ease-out);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__item[open] .faq__q-text {
    color: var(--color-accent);
  }
  .faq__a {
    padding-bottom: var(--s-6);
    padding-right: var(--s-7);
    max-width: 68ch;
    color: var(--color-text-2);
    font-size: var(--step-0);
    line-height: 1.65;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports selector(::details-content) {
      .faq__item {
        interpolate-size: allow-keywords;
      }
      .faq__item::details-content {
        block-size: 0;
        overflow: clip;
        opacity: 0;
        transition:
          block-size 380ms var(--ease-out),
          opacity 300ms var(--ease-out),
          content-visibility 380ms allow-discrete;
      }
      .faq__item[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }
</style>
