---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import FaqList from '@/components/FaqList.astro';
import NextStep from '@/components/NextStep.astro';
import { FAQ_GROUPS } from '@/data/faq';
import { AREAS } from '@/data/areas';
import { breadcrumbs, faqPage, webPage } from '@/lib/schema';

const path = '/duvidas/';
const title = 'Dúvidas frequentes';
const description =
  'Como funciona o primeiro contato, atendimento online, honorários, prazos e sigilo: respostas diretas às perguntas mais comuns sobre o escritório Quintela Brandt.';
const crumbs = [{ name: 'Dúvidas', href: path }];
const all = FAQ_GROUPS.flatMap((g) => g.items);
---

<Base title={title} description={description} schema={[webPage(path, title, description), breadcrumbs(crumbs), faqPage(path, all)]}>
  <PageHeader
    crumbs={crumbs}
    label="Dúvidas"
    title="Perguntas que *costumamos* ouvir."
    lead="Respostas diretas sobre como o escritório funciona. Quando a resposta depende do caso, dizemos isso com todas as letras."
  />

  <section class="section faq-page">
    <div class="container faq-page__grid">
      <nav class="faq-page__nav" aria-label="Temas">
        <p class="label">Temas</p>
        <ul role="list">
          {FAQ_GROUPS.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
        </ul>
        <p class="label faq-page__areas-label">Dúvidas por área</p>
        <ul role="list">
          {AREAS.map((a) => <li><a href={`/atuacao/${a.slug}/#afaq-title`}>{a.name}</a></li>)}
        </ul>
      </nav>

      <div class="faq-page__groups">
        {
          FAQ_GROUPS.map((g) => (
            <section id={g.id} class="faq-page__group" aria-labelledby={`${g.id}-title`}>
              <h2 id={`${g.id}-title`} class="h3 faq-page__group-title">
                {g.title}
              </h2>
              <FaqList items={g.items} />
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <NextStep
    title="Sua dúvida não está aqui?"
    text="Pergunte diretamente. Se for algo que depende da análise do seu caso, explicamos como funciona a reunião de análise."
    cta="Falar com o escritório"
  />
</Base>

<style>
  .faq-page__grid {
    display: grid;
    gap: var(--s-7);
  }
  .faq-page__nav {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .faq-page__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
  }
  .faq-page__nav a {
    display: inline-block;
    padding-block: 0.35rem;
    font-size: var(--step--1);
    font-weight: 560;
    color: var(--color-text-2);
    text-decoration: none;
  }
  .faq-page__nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .faq-page__areas-label {
    margin-top: var(--s-4);
  }
  .faq-page__groups {
    display: grid;
    gap: var(--s-9);
  }
  .faq-page__group {
    display: grid;
    gap: var(--s-4);
  }
  .faq-page__group-title {
    color: var(--color-accent);
  }
  @media (min-width: 64rem) {
    .faq-page__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .faq-page__nav {
      grid-column: 1 / span 3;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
    .faq-page__nav ul {
      flex-direction: column;
    }
    .faq-page__groups {
      grid-column: 5 / span 8;
    }
  }
</style>
